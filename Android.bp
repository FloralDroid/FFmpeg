    ],
    target: {
        android_x86_64: {
            srcs: [
                "libavutil/hwcontext_drm.c",
                "libavutil/hwcontext_vaapi.c",
                "libavutil/x86/aes_init.c",
                "libavutil/x86/cpu.c",
