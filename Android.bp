package {
    default_applicable_licenses: ["FloralDroid_FFmpeg_license"],
}

license {
    name: "FloralDroid_FFmpeg_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-LGPL-2.1-or-later"],
    license_text: ["COPYING.LGPLv2.1"],
}

cc_defaults {
    name: "floral_ffmpeg_android12_x86_64_defaults",
    vendor: true,
    compile_multilib: "64",
    c_std: "gnu17",
    cflags: [
        "-D_ISOC11_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        "-DHAVE_AV_CONFIG_H",
        "-D_LARGEFILE_SOURCE",
        "-Dstrtod=avpriv_strtod",
        "-fomit-frame-pointer",
        "-Wno-deprecated-declarations",
        "-Wno-error",
        "-Wno-missing-prototypes",
        "-Wno-pointer-sign",
        "-Wno-redundant-decls",
        "-Wno-string-plus-int",
        "-Wno-unused-const-variable",
    ],
    local_include_dirs: [
        "android/config/android-12/x86_64",
        "compat/stdbit",
        ".",
    ],
    header_libs: [
        "libdrm_headers",
        "libfloral_va_headers",
    ],
    target: {
        android_x86_64: {
            enabled: true,
        },
        android_x86: {
            enabled: false,
        },
        android_arm: {
            enabled: false,
        },
        android_arm64: {
            enabled: false,
        },
    },
}

cc_library_shared {
    name: "libfloral_ffmpeg_avutil",
    defaults: ["floral_ffmpeg_android12_x86_64_defaults"],
