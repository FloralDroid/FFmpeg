cc_library_shared {
    name: "libfloral_ffmpeg_avcodec",
    defaults: ["floral_ffmpeg_android12_defaults"],
    cflags: [
        "-DBUILDING_avcodec",
        "-DPIC",
    ],
    srcs: [
        "libavcodec/ac3_parser.c",
        "libavcodec/adts_parser.c",
        "libavcodec/allcodecs.c",
        "libavcodec/avcodec.c",
        "libavcodec/avdct.c",
        "libavcodec/bitstream.c",
        "libavcodec/bitstream_filters.c",
        "libavcodec/bsf.c",
        "libavcodec/bsf/vp9_superframe_split.c",
        "libavcodec/codec_desc.c",
        "libavcodec/codec_par.c",
        "libavcodec/d3d11va.c",
        "libavcodec/decode.c",
        "libavcodec/dirac.c",
        "libavcodec/dv_profile.c",
        "libavcodec/encode.c",
        "libavcodec/exif.c",
        "libavcodec/faandct.c",
        "libavcodec/faanidct.c",
        "libavcodec/fdctdsp.c",
        "libavcodec/float_scalarproduct.c",
        "libavcodec/frame_thread_encoder.c",
        "libavcodec/get_buffer.c",
        "libavcodec/idctdsp.c",
        "libavcodec/imgconvert.c",
        "libavcodec/jfdctfst.c",
        "libavcodec/jfdctint.c",
        "libavcodec/jni.c",
        "libavcodec/jrevdct.c",
        "libavcodec/log2_tab.c",
        "libavcodec/mathtables.c",
        "libavcodec/mediacodec.c",
        "libavcodec/mpeg12framerate.c",
        "libavcodec/options.c",
        "libavcodec/packet.c",
        "libavcodec/parser.c",
        "libavcodec/parsers.c",
        "libavcodec/profiles.c",
        "libavcodec/pthread.c",
        "libavcodec/pthread_frame.c",
        "libavcodec/pthread_slice.c",
        "libavcodec/qsv_api.c",
        "libavcodec/raw.c",
        "libavcodec/reverse.c",
        "libavcodec/simple_idct.c",
        "libavcodec/threadprogress.c",
        "libavcodec/timecode_internal.c",
        "libavcodec/tiff_common.c",
        "libavcodec/utils.c",
        "libavcodec/version.c",
        "libavcodec/vlc.c",
        "libavcodec/vorbis_parser.c",
        "libavcodec/vp9_parser.c",
        "libavcodec/xiph.c",
    ],
    target: {
        android_x86_64: {
            srcs: floral_ffmpeg_x86_codec_sources + [
                "libavcodec/hw_base_encode.c",
                "libavcodec/hw_base_encode_h264.c",
                "libavcodec/hw_base_encode_h265.c",
                "libavcodec/vaapi_av1.c",
                "libavcodec/vaapi_decode.c",
                "libavcodec/vaapi_encode.c",
                "libavcodec/vaapi_encode_av1.c",
                "libavcodec/vaapi_encode_h264.c",
                "libavcodec/vaapi_encode_h265.c",
                "libavcodec/vaapi_encode_mpeg2.c",
                "libavcodec/vaapi_encode_vp8.c",
                "libavcodec/vaapi_encode_vp9.c",
                "libavcodec/vaapi_h264.c",
                "libavcodec/vaapi_hevc.c",
                "libavcodec/vaapi_mpeg2.c",
                "libavcodec/vaapi_vp8.c",
                "libavcodec/vaapi_vp9.c",
                "libavcodec/x86/constants.c",
                "libavcodec/x86/fdct.c",
                "libavcodec/x86/fdctdsp_init.c",
                "libavcodec/x86/mpegvideo.c",
            ],
            header_libs: ["libfloral_va_headers"],
            shared_libs: ["libfloral_va_prebuilt"],
        },
        android_arm64: {
            srcs: [
                "libavcodec/aarch64/fdctdsp_init_aarch64.c",
                "libavcodec/aarch64/fdctdsp_neon.S",
                "libavcodec/aarch64/idctdsp_init_aarch64.c",
                "libavcodec/aarch64/idctdsp_neon.S",
                "libavcodec/aarch64/simple_idct_neon.S",
                "libavcodec/bitstreamfilter.c",
                "libavcodec/bsf/h264_mp4toannexb.c",
                "libavcodec/bsf/hevc_mp4toannexb.c",
                "libavcodec/bsf/packetsync.c",
                "libavcodec/bsf/sink.c",
                "libavcodec/bsf/source.c",
                "libavcodec/bsfgraph.c",
                "libavcodec/v4l2_buffers.c",
                "libavcodec/v4l2_context.c",
                "libavcodec/v4l2_fmt.c",
                "libavcodec/v4l2_m2m.c",
                "libavcodec/v4l2_m2m_dec.c",
                "libavcodec/v4l2_m2m_enc.c",
            ],
        },
    },
    shared_libs: [
        "libfloral_ffmpeg_avutil",
        "libm",
    ],
    export_generated_headers: ["floral_ffmpeg_android12_config"],
    export_include_dirs: [
        ".",
    ],
}
