package {
    default_applicable_licenses: ["FloralDroid_FFmpeg_license"],
}

license {
    name: "FloralDroid_FFmpeg_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-LGPL-2.1-or-later"],
    license_text: ["COPYING.LGPLv2.1"],
}

python_binary_host {
    name: "floral_ffmpeg_config_generator",
    main: "android/generate_config.py",
    srcs: ["android/generate_config.py"],
    version: {
        py2: {
            enabled: false,
        },
        py3: {
            enabled: true,
        },
    },
}

cc_genrule {
    name: "floral_ffmpeg_android12_config",
    vendor: true,
    compile_multilib: "64",
    tools: ["floral_ffmpeg_config_generator"],
    cmd: "$(location floral_ffmpeg_config_generator) --output $(genDir) $(in)",
    arch: {
        x86_64: {
            srcs: [
                "android/config/android-12/x86_64/config.h",
                "android/config/android-12/x86_64/config_components.h",
                "android/config/android-12/x86_64/libavcodec/bsf_list.c",
                "android/config/android-12/x86_64/libavcodec/codec_list.c",
                "android/config/android-12/x86_64/libavcodec/parser_list.c",
                "android/config/android-12/x86_64/libavutil/avconfig.h",
                "android/config/android-12/x86_64/libavutil/ffversion.h",
            ],
            out: [
                "config.h",
                "config_components.h",
                "libavcodec/bsf_list.c",
                "libavcodec/codec_list.c",
                "libavcodec/parser_list.c",
                "libavutil/avconfig.h",
                "libavutil/ffversion.h",
            ],
        },
        arm64: {
            srcs: [
                "android/config/android-12/arm64/config.h",
                "android/config/android-12/arm64/config_components.h",
                "android/config/android-12/arm64/libavcodec/bsf_list.c",
                "android/config/android-12/arm64/libavcodec/codec_list.c",
                "android/config/android-12/arm64/libavcodec/parser_list.c",
                "android/config/android-12/arm64/libavutil/avconfig.h",
                "android/config/android-12/arm64/libavutil/ffversion.h",
            ],
            out: [
                "config.h",
                "config_components.h",
                "libavcodec/bsf_list.c",
                "libavcodec/codec_list.c",
                "libavcodec/parser_list.c",
                "libavutil/avconfig.h",
                "libavutil/ffversion.h",
            ],
        },
    },
}

cc_defaults {
    name: "floral_ffmpeg_android12_defaults",
    vendor: true,
    compile_multilib: "64",
    c_std: "gnu17",
    cflags: [
        "-D_ISOC11_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        "-DHAVE_AV_CONFIG_H",
        "-D_LARGEFILE_SOURCE",
        "-Dstrtod=avpriv_strtod",
        "-fomit-frame-pointer",
        "-Wno-deprecated-declarations",
        "-Wno-error",
        "-Wno-missing-prototypes",
        "-Wno-pointer-sign",
        "-Wno-redundant-decls",
        "-Wno-string-plus-int",
        "-Wno-unused-const-variable",
    ],
    local_include_dirs: [
        "compat/stdbit",
        "libavcodec",
        ".",
    ],
    generated_headers: ["floral_ffmpeg_android12_config"],
    target: {
        android_x86_64: {
            enabled: true,
            cflags: ["-DFLORAL_FFMPEG_BACKEND_VAAPI=1"],
        },
        android_x86: {
            enabled: false,
        },
        android_arm: {
            enabled: false,
        },
        android_arm64: {
            enabled: true,
            cflags: ["-DFLORAL_FFMPEG_BACKEND_V4L2_M2M=1"],
            // FFmpeg's AArch64 assembly directly addresses library-internal
            // globals and relies on its standard shared-library link policy.
            ldflags: ["-Wl,-Bsymbolic"],
        },
    },
}

cc_library_shared {
